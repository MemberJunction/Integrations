{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-postgresql",
  "displayName": "PostgreSQL Connector",
  "description": "PostgreSQL connector for MemberJunction — ingest data from an external PostgreSQL and its wire-compatible engines (Supabase, Neon, Redshift, CockroachDB, Yugabyte, Aurora-PG) via a shared External Data Source. Schema is discovered at connection time; the connector delegates all connectivity to the EDS PostgresExternalDriver driver.",
  "version": "1.0.1",
  "license": "ISC",
  "icon": "fa-solid fa-database",
  "color": "#336791",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.46.0 <6.0.0",
  "schema": {
    "name": "mj_connector_postgresql",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-postgresql",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "platform",
    "database"
  ],
  "tags": [
    "postgresql",
    "database",
    "external-data-source",
    "connector",
    "integration"
  ]
}
