{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-mj-to-mj",
  "displayName": "MJ to MJ Connector",
  "description": "Read-only connector that pulls conversational data (Conversations, Conversation Details, optional AI Agent Runs/Steps) from a remote MemberJunction instance via its GraphQL API. Maps to MJ: Conversations and MJ: Conversation Details. Every MJ deploymen...",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-share-nodes",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.42.0 <6.0.0",
  "schema": {
    "name": "mj_connector_mj_to_mj",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-mj-to-mj",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "platform"
  ],
  "tags": [
    "mj-to-mj",
    "platform",
    "connector",
    "integration"
  ]
}
