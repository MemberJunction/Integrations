{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-business-central",
  "displayName": "Business Central Connector",
  "description": "Microsoft Dynamics 365 Business Central connector — REST/OData v4 API v2.0 across finance, sales, purchasing, inventory and master-data objects, with OAuth 2.0 client-credentials (S2S) auth against Microsoft Entra ID and additive runtime $metadata (EDMX) discovery of the tenant's own entity sets and published web-service pages.",
  "version": "2.0.2",
  "license": "ISC",
  "icon": "fa-brands fa-microsoft",
  "color": "#0078d4",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <7.0.0",
  "schema": {
    "name": "mj_connector_business_central",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-business-central",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "finance"
  ],
  "tags": [
    "business-central",
    "dynamics-365",
    "microsoft",
    "erp",
    "finance",
    "connector",
    "integration"
  ]
