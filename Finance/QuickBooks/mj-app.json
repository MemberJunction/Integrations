{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-quickbooks",
  "displayName": "QuickBooks Connector",
  "description": "QuickBooks Online REST API v3 integration for syncing accounting data (customers, vendors, invoices, bills, items, payments, reports) using OAuth 2.0 authentication scoped by realmId.",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-calculator",
  "color": "#2ca01c",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "metadata": {
    "directory": "metadata",
    "processOnInstall": true
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-quickbooks",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "finance"
  ],
  "tags": [
    "quickbooks",
    "finance",
    "connector",
    "integration"
  ]
}
