{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-hubspot",
  "displayName": "HubSpot Connector",
  "description": "HubSpot CRM connector for MemberJunction — sync contacts, companies, deals, and activities, with the full curated object catalog.",
  "version": "1.1.3",
  "license": "ISC",
  "icon": "fa-brands fa-hubspot",
  "color": "#ff7a59",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.42.0 <6.0.0",
  "schema": {
    "name": "mj_connector_hubspot",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-hubspot",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "crm"
  ],
  "tags": [
    "hubspot",
    "crm",
    "connector",
    "integration"
  ]
}
