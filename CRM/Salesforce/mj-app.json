{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-salesforce",
  "displayName": "Salesforce Connector",
  "description": "Salesforce REST connector: syncs CRM SObjects (Account, Contact, Lead, Opportunity, Case, Campaign, Task, Event, User) via SOQL watermark incremental sync; CRUD for most objects; custom __c discovered at runtime; OAuth2 JWT/Client Credentials.",
  "version": "1.0.0",
  "license": "ISC",
  "color": "#00a1e0",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.42.0 <6.0.0",
  "schema": {
    "name": "mj_connector_salesforce",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-salesforce",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "crm"
  ],
  "tags": [
    "salesforce",
    "crm",
    "connector",
    "integration"
  ]
}
