{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-slayte",
  "displayName": "Slayte Connector",
  "description": "Slayte AMS connector for MemberJunction — read-only sync for Individuals and Organizations (via Shared CRM Queries), Committees, Directories, and Events via the Slayte REST API v2.",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "icon": "fa-solid fa-people-group",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <7.0.0",
  "schema": {
    "name": "mj_connector_slayte",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-slayte",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "ams"
  ],
  "tags": [
    "slayte",
    "ams",
    "crm",
    "events",
    "committees",
    "connector",
    "integration"
  ]
}
