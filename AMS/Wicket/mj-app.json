{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-wicket",
  "displayName": "Wicket Connector",
  "description": "Wicket membership management platform integration for syncing people, organizations, memberships, groups, connections, and contact information via JSON:API",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-id-badge",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "mj_connector_wicket",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
