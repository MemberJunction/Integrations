{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-protech",
  "displayName": "Protech Connector",
  "description": "Protech AMS (UX 365) connector — association management built on Microsoft Dynamics 365/Dataverse. Thin leaf over the Dataverse connector: OAuth2 client credentials (Entra ID), runtime EntityDefinitions discovery of pa_* + standard tables, change-tracking incremental, full CRUD.",
  "version": "0.1.0",
  "license": "ISC",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "mj_connector_protech",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-protech",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "ams"
  ],
  "tags": [
    "protech",
    "ams",
    "connector",
    "integration"
  ]
}
