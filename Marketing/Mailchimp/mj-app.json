{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-mailchimp",
  "displayName": "Mailchimp Connector",
  "description": "Mailchimp Marketing API v3.0 integration for syncing audiences, campaigns, automations, templates, reports, and e-commerce data. Uses Basic authentication with an API key whose suffix identifies the data center.",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-brands fa-mailchimp",
  "color": "#ffe01b",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "mj_connector_mailchimp",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-mailchimp",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "marketing"
  ],
  "tags": [
    "mailchimp",
    "marketing",
    "connector",
    "integration"
  ]
}
