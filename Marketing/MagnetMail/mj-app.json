{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-magnetmail",
  "displayName": "MagnetMail Connector",
  "description": "Higher Logic MagnetMail (formerly Real Magnet) email-marketing platform. SOAP API (mmapi.asmx) covering recipients, groups, messages, message tracking (opens/clicks/bounces/unsubscribes), upload jobs, saved searches, personalization fields, events, and the Personify subscription bridge. Two-step session auth; incremental message sync; read + write (create/update).",
  "version": "3.0.3",
  "license": "ISC",
  "icon": "fa-solid fa-envelope-circle-check",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.42.0 <6.0.0",
  "schema": {
    "name": "mj_connector_magnetmail",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-magnetmail",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "marketing"
  ],
  "tags": [
    "magnetmail",
    "marketing",
    "connector",
    "integration"
  ]
}
