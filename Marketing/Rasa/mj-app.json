{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-rasa-io",
  "displayName": "Rasa.io Connector",
  "description": "Rasa.io newsletter platform integration for syncing persons (subscribers) and posts (content) via the Rasa.io REST API",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-newspaper",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "mj_connector_rasa_io",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-rasa-io",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "marketing"
  ],
  "tags": [
    "rasa-io",
    "marketing",
    "connector",
    "integration"
  ]
}
