{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-reply",
  "displayName": "Reply.io Connector",
  "description": "Reply.io AI-powered sales-engagement platform. Syncs contacts and accounts, sequences (steps, variants, templates, schedules), outreach channels (email accounts, LinkedIn accounts), tasks, the shared inbox, and webhooks via the Reply.io v3 REST API. Reads are incremental via content-hash (Reply exposes no server-side watermark); 34 objects support write-back.",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-paper-plane",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.46.0 <6.0.0",
  "schema": {
    "name": "mj_connector_reply",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-reply",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "marketing"
  ],
  "tags": [
    "reply",
    "reply-io",
    "sales-engagement",
    "marketing",
    "connector",
    "integration"
  ]
}
