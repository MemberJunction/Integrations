{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-propfuel",
  "displayName": "PropFuel Connector",
  "description": "PropFuel AI-powered member insights and engagement platform — data export file-feed integration. Retrieves hourly JSON files via list/download/ack endpoints.",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-file-export",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "mj_connector_propfuel",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-propfuel",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "marketing"
  ],
  "tags": [
    "propfuel",
    "marketing",
    "connector",
    "integration"
  ]
}
