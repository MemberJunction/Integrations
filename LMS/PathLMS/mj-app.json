{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-path-lms",
  "displayName": "Path LMS Connector",
  "description": "Path LMS (Blue Sky eLearn) Reporting API connector — pull-only GraphQL analytics over 16 report query surfaces. Two-step bearer auth (applicationId + applicationSecret then 12-hour JWT); no writes. All data via POST to the single GraphQL endpoint.",
  "version": "1.1.0",
  "license": "ISC",
  "icon": "fa-solid fa-graduation-cap",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.42.0 <6.0.0",
  "schema": {
    "name": "mj_connector_path_lms",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-path-lms",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "lms"
  ],
  "tags": [
    "path-lms",
    "lms",
    "connector",
    "integration"
  ]
}
