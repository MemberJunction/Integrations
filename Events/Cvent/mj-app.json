{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-cvent",
  "displayName": "Cvent Connector",
  "description": "Cvent event management platform connector. Syncs events, contacts, attendees, sessions, speakers, exhibitors, housing, surveys, RFPs, webcasts, and related objects via the Cvent Platform REST API (OAuth 2.0 client credentials).",
  "version": "1.0.0",
  "license": "ISC",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "metadata": {
    "directory": "metadata",
    "processOnInstall": true
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/integration-connectors",
        "role": "bootstrap",
        "startupExport": "registerConnectors"
      }
    ]
  },
  "categories": [
    "events"
  ],
  "tags": [
    "cvent",
    "events",
    "connector",
    "integration"
  ]
}
