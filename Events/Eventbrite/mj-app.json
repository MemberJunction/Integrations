{
  "$schema": "https://memberjunction.org/schemas/mj-app.schema.json",
  "manifestVersion": 1,
  "name": "connector-eventbrite",
  "displayName": "Eventbrite Connector",
  "description": "Eventbrite event ticketing & management connector. Syncs organizations, events, event series, venues, ticket classes, ticket groups, orders, attendees, questions, discounts, media, webhooks, and related objects via the Eventbrite Platform REST API v3 (Bearer private-token / OAuth2 access token).",
  "version": "2.0.1",
  "license": "ISC",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/Integrations",
  "mjVersionRange": ">=5.42.0 <6.0.0",
  "schema": {
    "name": "mj_connector_eventbrite",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@memberjunction/connector-eventbrite",
        "role": "bootstrap",
        "startupExport": "registerConnector"
      }
    ]
  },
  "categories": [
    "events"
  ],
  "tags": [
    "eventbrite",
    "events",
    "connector",
    "integration"
  ]
}
